{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kydrywall.com.br"
        }
      ],
      "destination": "https://www.kydrywall.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/localizacao/:location",
      "destination": "/drywall-em/:location",
      "permanent": true
    }
  ]
}
